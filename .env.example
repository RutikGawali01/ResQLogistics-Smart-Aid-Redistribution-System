# ==============================================================================
# AidFlow Environment Configuration Template
# Copy this file to .env in the root or individual app folders for local setup.
# ==============================================================================

# Common Environment
NODE_ENV=development

# ------------------------------------------------------------------------------
# Server (apps/server)
# ------------------------------------------------------------------------------
PORT=5000
SERVER_HOST=localhost
CORS_ORIGIN=http://localhost:5173

# Database (MongoDB) - No Redis required or permitted!
MONGODB_URI=mongodb://localhost:27017/aidflow

# Authentication (JWT & Security)
JWT_SECRET=aidflow_super_secret_dev_key_at_least_32_characters_long_2026
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

# ------------------------------------------------------------------------------
# Client (apps/client) - Exposed to Vite using VITE_ prefix
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:5000/api
VITE_SOCKET_URL=http://localhost:5000
VITE_DEFAULT_MAP_LAT=37.7749
VITE_DEFAULT_MAP_LNG=-122.4194
VITE_DEFAULT_MAP_ZOOM=13

# ------------------------------------------------------------------------------
# Worker (apps/worker) - MongoDB-backed queue / background processor
# ------------------------------------------------------------------------------
WORKER_POLL_INTERVAL_MS=3000
WORKER_CONCURRENCY=5
WORKER_LOCK_TIMEOUT_MS=60000
WORKER_MAX_RETRIES=3
